{
    admin off
    auto_https off
}
:3000 {
    @backend path /api /api/* /_/api /_/api/* /auth/* /v/* /_health /_ping /_readiness
    handle @backend {
        reverse_proxy 127.0.0.1:3001
    }
    @admin path /_ /_/*
    handle @admin {
        reverse_proxy 127.0.0.1:5174
    }
    @vite path /@vite/* /@id/* /@fs/* /src/* /node_modules/* /.svelte-kit/* /fonts/* /__frontend_hmr /_app/*
    handle @vite {
        reverse_proxy 127.0.0.1:5173
    }
    handle {
        reverse_proxy 127.0.0.1:3001
    }
}
